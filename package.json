{
  "name": "@obinexusltd/asm-polycall",
  "version": "1.0.0",
  "description": "GNU-assembler shims over the Polycall binding ABI v1 (polycall >= 1.1.0): x86-64 (System V, Win64) and x86-32 (Linux, Windows) tested; AArch64 and AArch32 Linux tested under emulation; Mach-O and Windows on ARM64 assemble.",
  "keywords": [
    "assembly",
    "asm",
    "polycall",
    "libpolycall",
    "ffi",
    "x86-64",
    "aarch64"
  ],
  "homepage": "https://github.com/obinexus/asm-polycall#readme",
  "bugs": {
    "url": "https://github.com/obinexus/asm-polycall/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/asm-polycall.git"
  },
  "license": "MIT",
  "author": {
    "name": "Nnamdi Michael Okpala",
    "email": "okpalan@protonmail.com"
  },
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./src/*": "./src/*",
    "./include/*": "./include/*",
    "./examples/*": "./examples/*",
    "./config": "./asm-polycallrc",
    "./manifest": "./polycall-binding.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "include/",
    "examples/",
    "scripts/",
    "tests/",
    "Makefile",
    "polycall-binding.json",
    "asm-polycallrc",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "build": "make",
    "clean": "make clean",
    "test": "make test && node tests/package.test.js",
    "verify": "make verify-dry",
    "prepack": "npm run test && npm run verify"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  }
}
